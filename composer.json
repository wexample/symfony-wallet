{
  "name": "wexample/symfony-wallet",
  "description": "The credentials of a Symfony app kept as Doctrine entities, their types declared in its configuration, the php-wallet built from them",
  "type": "library",
  "license": "MIT",
  "version": "2.0.0",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyWallet\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyWallet\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "doctrine/orm": "^3.0",
    "wexample/php-wallet": ">=2.0.0",
    "wexample/symfony-helpers": ">=19.2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ]
}